<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#F2163460" android:centerColor="#F00C1E38" android:endColor="#F4050E1E" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:width="1dp" android:height="1dp" android:gravity="fill" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" android:drawable="@drawable/tex_brushed_tile" />
    <item android:width="1dp" android:height="1dp" android:gravity="fill" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" android:drawable="@drawable/tex_noise_tile" />
    <item>
        <shape>
            <gradient android:angle="270" android:type="linear" android:centerY="0.35" android:startColor="#26FFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:centerY="0.25" android:startColor="#66000000" android:centerColor="#00000000" android:endColor="#00000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#7048B8FF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
