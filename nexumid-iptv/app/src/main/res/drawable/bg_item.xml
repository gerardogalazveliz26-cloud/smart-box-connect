<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="0" android:startColor="#1E5FA8" android:endColor="#0F2E55" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/surface_focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <gradient android:angle="0" android:startColor="#1A3D6B" android:endColor="#0E2440" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#991EA0FF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
