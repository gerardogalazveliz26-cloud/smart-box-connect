<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="0" android:startColor="#2A74C8" android:centerColor="#1A4D8E" android:endColor="#0F2E55" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp" android:drawable="@drawable/tex_brushed_tile" />
            <item>
                <shape>
                    <gradient android:angle="270" android:centerY="0.45" android:startColor="#33FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="@color/cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/surface_focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="0" android:startColor="#1E467A" android:endColor="#0E2440" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#AA48B8FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
