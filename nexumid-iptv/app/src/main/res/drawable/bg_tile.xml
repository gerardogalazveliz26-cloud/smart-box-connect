<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="315" android:startColor="#1EA0FF" android:endColor="#0A4FB0" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="315" android:startColor="#1784D6" android:endColor="#083F8C" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#E6122A4A" android:endColor="#E608142A" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#661EA0FF" />
        </shape>
    </item>
</selector>
