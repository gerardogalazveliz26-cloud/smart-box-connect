<?xml version="1.0" encoding="utf-8"?>
<!-- Halo azul alrededor de la tarjeta enfocada (el contenido va con 6dp de margen) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape><corners android:radius="24dp" /><stroke android:width="3dp" android:color="#141EA0FF" /></shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><corners android:radius="23dp" /><stroke android:width="3dp" android:color="#2A1EA0FF" /></shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape><corners android:radius="21dp" /><stroke android:width="3dp" android:color="#663FB4FF" /></shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape><corners android:radius="19dp" /><stroke android:width="2.5dp" android:color="#FF62DCFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape><corners android:radius="19dp" /><stroke android:width="2dp" android:color="#FF3FD4FF" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
