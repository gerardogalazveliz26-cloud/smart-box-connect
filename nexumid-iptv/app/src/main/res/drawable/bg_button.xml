<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#4FC6FF" android:centerColor="#1E8BFF" android:endColor="#0A55C2" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp">
                <shape>
                    <gradient android:angle="270" android:centerY="0.45" android:startColor="#66FFFFFF" android:centerColor="#14FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="24dp" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#1E8BFF" android:endColor="#0A4FB0" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#203F6C" android:centerColor="#122848" android:endColor="#0A182E" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:width="1dp" android:height="1dp" android:gravity="fill" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" android:drawable="@drawable/tex_brushed_tile" />
            <item android:left="2dp" android:top="1dp" android:right="2dp">
                <shape>
                    <gradient android:angle="270" android:centerY="0.4" android:startColor="#2EFFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="23dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="#AA48B8FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
