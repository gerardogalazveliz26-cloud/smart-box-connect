<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#2462A8" android:endColor="#0E2747" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:width="1dp" android:height="1dp" android:gravity="fill" android:drawable="@drawable/tex_noise_tile" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <stroke android:width="3dp" android:color="@color/cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#14305A" android:endColor="#08162A" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:width="1dp" android:height="1dp" android:gravity="fill" android:drawable="@drawable/tex_noise_tile" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#5548B8FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
