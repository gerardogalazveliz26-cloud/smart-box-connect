<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="270" android:startColor="#1B4A80" android:endColor="#0E2747" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/cyan" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#10243F" android:endColor="#0A1A2E" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#401EA0FF" />
        </shape>
    </item>
</selector>
