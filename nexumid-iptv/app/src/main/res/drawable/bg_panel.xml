<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#F0132C50" android:endColor="#F2050E1E" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp" android:drawable="@drawable/tex_carbon_tile" />
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp" android:drawable="@drawable/tex_noise_tile" />
    <item>
        <shape>
            <gradient android:angle="270" android:centerY="0.2" android:startColor="#22FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#7748B8FF" />
        </shape>
    </item>
</layer-list>
