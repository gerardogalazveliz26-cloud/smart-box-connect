<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta vertical para pedir una prueba por WhatsApp (activación en TV) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trialCard"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTrialTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:shadowColor="#991EA0FF"
        android:shadowRadius="12"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivQr"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_qr"
        android:contentDescription="Código QR de WhatsApp para pedir una prueba"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvTrialText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#D6E2F2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvTrialNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/cyan"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnTrial"
        style="@style/Btn"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="💬  Pedir prueba por WhatsApp"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
