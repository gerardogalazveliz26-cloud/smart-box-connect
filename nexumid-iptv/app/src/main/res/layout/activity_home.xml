<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/brand_bg"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="16dp"
            android:paddingEnd="30dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="62dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/brand_wordmark"
                    android:contentDescription="NexumID IPTV" />

                <TextView
                    android:id="@+id/tvAccount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="2"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="hh:mm a"
                    android:format24Hour="hh:mm a"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="16dp"
                    android:background="#4DFFFFFF" />

            <ImageView
                android:id="@+id/ivWifi"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_wifi"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:id="@+id/btnBell"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="Novedades"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/bellDot"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot_badge"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnGear"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="Ajustes"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    android:importantForAccessibility="no" />
            </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge"
                android:padding="8dp"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="178dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tileLive"
                    layout="@layout/view_hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.28" />

                <include
                    android:id="@+id/tileMovies"
                    layout="@layout/view_hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tileSeries"
                    layout="@layout/view_hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.06" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <include android:id="@+id/tileSearch" layout="@layout/view_tile_small"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

                <include android:id="@+id/tileFav" layout="@layout/view_tile_small"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" />

                <include android:id="@+id/tileAccounts" layout="@layout/view_tile_small"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" />

                <include android:id="@+id/tileSettings" layout="@layout/view_tile_small"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_hero_live"
                    android:tint="@color/primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvRecent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Canales recientes"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Seguir viendo"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
