<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="315" android:startColor="#E040FB" android:endColor="#2EA8FF" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="315" android:startColor="#B030D0" android:endColor="#2088D0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#E6261244" android:endColor="#E6120A24" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#66E040FB" />
        </shape>
    </item>
</selector>
