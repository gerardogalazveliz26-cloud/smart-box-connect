<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="0" android:startColor="#5A1F8A" android:endColor="#2A1650" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/surface_focus" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#2C1650" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#88E040FB" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
