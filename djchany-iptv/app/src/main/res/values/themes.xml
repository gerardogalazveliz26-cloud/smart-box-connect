<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DJChany" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/magenta</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/cyan</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="alertDialogTheme">@style/Dialog.DJChany</item>
    </style>

    <style name="Theme.DJChany.Splash">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Dialog.DJChany" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/cyan</item>
        <item name="android:background">@color/surface2</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Section">
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Btn">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
